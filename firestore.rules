rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /star_prs/{recordId} {
      allow read, write: if request.auth != null;
    }

    match /star_dcs/{recordId} {
      allow read, write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
