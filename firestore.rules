rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function roleIs(role) {
      return request.auth != null && 'portalRole' in request.auth.token && request.auth.token.portalRole == role;
    }
    function canRead() { return roleIs('viewer') || roleIs('editor') || roleIs('admin'); }
    function canEdit() { return roleIs('editor') || roleIs('admin'); }
    function isAdmin() { return roleIs('admin'); }
    function isValidPR(data) {
      return data.prNumber is string && data.prNumber.size() > 0 && data.prNumber.size() <= 100
        && (!('items' in data) || data.items is list);
    }
    function isValidDC(data) {
      return data.dcNumber is string && data.dcNumber.size() > 0 && data.dcNumber.size() <= 100
        && (!('itemsShipped' in data) || data.itemsShipped is list);
    }
    match /star_prs/{prId} {
      allow read: if canRead();
      allow create, update: if canEdit() && isValidPR(request.resource.data);
      allow delete: if isAdmin();
    }
    match /star_dcs/{dcId} {
      allow read: if canRead();
      allow create, update: if canEdit() && isValidDC(request.resource.data);
      allow delete: if isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
