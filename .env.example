# Optional default Gemini API Key from Google AI Studio (https://aistudio.google.com/app/apikey)
# Note: Users can also input their own API key directly within the app settings.
VITE_GEMINI_API_KEY=

# Firebase Web app configuration (available from Firebase Console > Project settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
# Optional: set all of these from a separate Firebase Web app for isolated testing.
# Leave blank for the production project defaults.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Development only: opt in to local mode when Firebase is unconfigured. Never used in production.
VITE_ALLOW_LOCAL_MODE=false

# Optional: Drive API v3 key restricted to the intended browser origins; only public/shared-with-key Drive data is accessible.
# Private Drive folders require OAuth, which this app does not currently implement.
VITE_GOOGLE_DRIVE_API_KEY=
