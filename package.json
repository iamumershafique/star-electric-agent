{
  "name": "star-electric-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy:firebase": "node scripts/check-release.mjs hosting && npm run validate:firebase:production && npm run build && firebase deploy --only hosting --project star-agent-jpf --non-interactive",
    "deploy:staging": "node scripts/check-preview.mjs && npm run validate:firebase && npm run build && node scripts/deploy-preview.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "dev:demo": "vite --config demo-preview/vite.config.ts",
    "sites:merge": "tsx scripts/merge-sites.ts",
    "drive:watch": "node scripts/driveSyncDaemon.cjs",
    "validate:firebase": "node scripts/validateFirebaseConfig.mjs",
    "test": "vitest run",
    "backup:inspect": "tsx scripts/inspect-backup.ts",
    "roles:manage": "node scripts/manage-role.mjs",
    "test:rules": "firebase emulators:exec --project demo-star-electric --only firestore,storage \"node --test rules-tests/security.mjs\"",
    "deploy:rules": "node scripts/check-release.mjs rules && npm run test:rules && firebase deploy --only firestore:rules,storage --project star-agent-jpf --non-interactive",
    "validate:firebase:production": "node scripts/validateFirebaseConfig.mjs --project star-agent-jpf"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "lucide-react": "^1.46.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "fake-indexeddb": "^6.2.8",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.31.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  }
}
